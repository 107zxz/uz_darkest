class Abbey : BaseFighter {
	States {
	SPAWN:
	IDLE:
	EBBF ABCDEFGHIJKLMN 6 {
		A_SetSize(12);
		if (!rollbackManaged) otherP.combo = null;
	}
	Loop;
	
	CROUCH:
	EBCH A 2 A_SetSize(12);
	Loop;
	
	WALK:
	EBWK BA 9;
	Loop;
	
	RUN:
	EBWK CA 7;
	Loop;
	
	RUNSTOP:
	EB5H I 14;
	Goto IDLE;
	
	BACKDASH:
	EB5H I 10;
	Goto IDLE;
	
	JUMP:
	EBAR A 2;
	Loop;
	
	LAND:
	EBCH A 3;
	Goto IDLE;
	
	PAIN:
// 	TNT1 A 0 { if (!rollbackManaged) A_Pain(); }
	TNT1 A 0 A_SetSize(12);
	EBHT ABBB 7;
	Goto IDLE;
	
	WALLBOUNCE:
// 	TNT1 A 0 { if (!rollbacskManaged) A_Pain(); }
	TNT1 A 0 A_SetSize(12);
	EBWB AAAAAAAAAAAAAAAABBBBBBBBBBBBBBBBB 2 {
		if (Pos.X - otherP.Pos.X > 150 && Vel.X > 0) {
			Vel.Z = (3) * FRAME_DELTA;
			Vel.X = -Abs(Vel.X) / 3;
		}
		if (Pos.X - otherP.Pos.X < -150 && Vel.X < 0) {
			Vel.Z = (3) * FRAME_DELTA;
			Vel.X = Abs(Vel.X) / 3;
		}
	}
	Goto PAIN;
	
	FALL:
	EBFL ABC 14;
	EBFL C -1;
	Loop;
	
	WIN:
	EBWN ABCD 10;
	WINLAUGH:
	EBWN EF 17;
	Loop;

	BLOCK:
	EBBK AA 9 A_SetSize(12);
	Goto IDLE;
	
	CROUCHBLOCK:
	EBCB A 17 A_SetSize(12);
	Goto IDLE;
	
	GRAB:
	EBGB A 5 {Vel.X += ((1-Angle / 90)*2) * FRAME_DELTA;}
	EBGB B 24 {
		if (HitLine(32,(0,5.25),0,'SmashPuff',(0,0),'GRAB',MOVE_GRAB | MOVE_NOCANCEL | MOVE_NOHITAIR)) {
			SetStateLabel("THROW");
		}
	}
	Goto IDLE;
	
	THROW:
	EBGB A 9 {
		otherP.SetStateLabel("PAIN");
		
	}
	EBAR A 2 {
		SetOrigin((Pos.X,0,Pos.Z+1),true);
		Vel.Z = (8) * FRAME_DELTA;
		Vel.X = (3 * (1-Angle/90)) * FRAME_DELTA;
	}
	EBAR AAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 {
		otherP.SetStateLabel("PAIN");
		otherP.SetOrigin((Pos.X-20* (1-Angle/90),0,Pos.Z+30),true);
		inAir = false;
	}
	EB22 A 2 {
		SetOrigin((Pos.X,0,0),true);
		otherP.SetOrigin((Pos.X+20 * (1-Angle/90),0,0),true);
		HitLine(96,(0,0),HITSTUN_HEAVY,'SlashPuff',(0.8,6),'THROW', MOVE_NOCANCEL);
	}
	EB22 B 3 {
		HitLine(96,(0,0),HITSTUN_HEAVY,'SlashPuff',(2.5,8),'THROW2', MOVE_NOCANCEL);
	}
	EB22 A 14;
	Goto IDLE;
	
	J5P:
	EBJP A 3;
	EBJP A 14 HitLine(32,(0,-16),HITSTUN_MEDIUM,'SmashPuff',(0.5,2),'J5P', MOVE_BLOCKHIGH);
	Goto JUMP;
	
	J5S:
	EBJP A 5;
	EBJS A 3 {
		HitLine(32,(0,-8),HITSTUN_MEDIUM,'SlashPuff',(0.75,0),'J5S', MOVE_BLOCKHIGH) ||
		HitLine(32,(0,0),HITSTUN_MEDIUM,'SlashPuff',(0.75,0),'J5S', MOVE_BLOCKHIGH) ||
		HitLine(32,(0,-16),HITSTUN_MEDIUM,'SlashPuff',(0.75,0),'J5S', MOVE_BLOCKHIGH);
	}
	EBJS A 3 {
		HitLine(32,(0,-8),HITSTUN_LIGHT,'SlashPuff',(0.75,0),'J5S2', MOVE_BLOCKHIGH) ||
		HitLine(32,(0,0),HITSTUN_LIGHT,'SlashPuff',(0.75,0),'J5S2', MOVE_BLOCKHIGH) ||
		HitLine(32,(0,-16),HITSTUN_LIGHT,'SlashPuff',(0.75,0),'J5S2', MOVE_BLOCKHIGH);
	}
	Goto JUMP;
	
	J5H:
	EBJP A 7;
	EBJH A 14 {
		HitLine(64,(0,0),HITSTUN_MEDIUM,'SlashPuff',(1,0),'J5H', MOVE_BLOCKHIGH, (0,2.5)) ||
		HitLine(64,(0,-16),HITSTUN_MEDIUM,'SlashPuff',(1,0),'J5H', MOVE_BLOCKHIGH, (0,2.5)) ||
		HitLine(64,(0,16),HITSTUN_MEDIUM,'SlashPuff',(1,0),'J5H', MOVE_BLOCKHIGH, (0,2.5));
	}
	Goto JUMP;
	
	N5P:
	EB5K BC 2;
	EB5K D 3 HitLine(32,(0,0),HITSTUN_LIGHT,'SmashPuff',(0,0),'N5P');
	EB5K E 3;
	EB5K FG 2;
	Goto IDLE;
	
	N5S:
	EB5S B 4;
	EB5S C 6;
	EB5S D 3 {
		A_SetSize(64);
		HitLine(96,(0,0),HITSTUN_MEDIUM,'SlashPuff',(2,0),'N5S') ||
		HitLine(96,(0,16),HITSTUN_MEDIUM,'SlashPuff',(2,0),'N5S');
	}
	EB5S E 19 A_SetSize(12);
	Goto IDLE;
	
	N5H:
	EB5H BCDE 3;
	EB5H F 8 {
		HitLine(64,(0,0),HITSTUN_MEDIUM,'SlashPuff',(0.4,6),'N5H');
	}
	EB5H GHD 4;
	Goto IDLE;
	
	N2P:
	EBCP A 2;
	EBCP A 3 HitLine(32,(0,-16),HITSTUN_LIGHT,'SmashPuff',(0.4,0),'N2P');
	EBCP B 5;
	EBCH A 5;
	Goto IDLE;
	
	N2S:
	EBCM A 9;
	EBCM B 3 HitLine(64,(0,-16),HITSTUN_MEDIUM,'SlashPuff',(0.4,6),'N2S',MOVE_BLOCKLOW);
	EBCM C 17;
	EBCH A 3;
	Goto IDLE;

	N2H:
	EB2H BCD 5;
	EB2H E 5 {
		HitLine(32,(20.75,33.75),HITSTUN_MEDIUM,'SlashPuff',(0.4,6),'N2H');
		HitLine(32,(0,0),HITSTUN_MEDIUM,'SlashPuff',(0.4,6),'N2H');
	}
	EB2H FG 5;
	Goto IDLE;
	
	236L:
	EB26 AAB 5;
	EB26 C 5;
	EB26 DD 5;
	Goto IDLE;
	
	236M:
	EB26 AAB 5;
	EB26 C 5;
	EB26 DD 5;
	Goto IDLE;
	
	236H:
	EB26 AAB 5;
	EB26 C 5;
	EB26 DD 5;
	Goto IDLE;
	
	623H:
	EB63 AA 5 {
		cancelTics = 0;
		bSHOOTABLE = false;
	}
	EB63 B 5 {
		HitLine(64,(0,0),HITSTUN_MEDIUM,'SlashPuff',(0,3),'623H',MOVE_NOCANCEL) ||
		HitLine(64,(0,-16),HITSTUN_MEDIUM,'SlashPuff',(0,3),'623H',MOVE_NOCANCEL);
	}
	EB63 CD 3 {
		bSHOOTABLE = true;
	}
	EB63 E 5 {
		HitLine(64,(0,0),HITSTUN_MEDIUM,'SlashPuff',(0,3),'623H2',MOVE_NOCANCEL) ||
		HitLine(64,(0,-16),HITSTUN_MEDIUM,'SlashPuff',(0,3),'623H2',MOVE_NOCANCEL);
	}
	EB63 B 5 {
		HitLine(64,(0,0),HITSTUN_MEDIUM,'SlashPuff',(2,3),'623H3',MOVE_NOCANCEL) ||
		HitLine(64,(0,-16),HITSTUN_MEDIUM,'SlashPuff',(2,3),'623H3',MOVE_NOCANCEL);
	}
	EB63 CAA 5;
	TNT1 A 0 {
		bSHOOTABLE = true;
	}
	Goto IDLE;
	
	214L:
	EBQB DEGG 2;
	EBQB HHII 2 {Vel.X = (6 * (1-Angle/90)) * FRAME_DELTA;}
	EBCH A 3 {
		SetOrigin((Pos.X + 40*(1-Angle/90),0,Pos.Z),false);
	}
	Goto IDLE;
	
	214H:
	EBQB BCDE 3;
	EBQB F 5 {
		HitLine(96,(0,8),HITSTUN_HEAVY,'SlashPuff',(0.4,4),'214H') ||
		HitLine(96,(0,-16),HITSTUN_HEAVY,'SlashPuff',(0.4,4),'214H');
	}
	EBQB F 7 {
		HitLine(96,(0,8),HITSTUN_HEAVY,'SlashPuff',(0.4,7),'214H2') ||
		HitLine(96,(0,-16),HITSTUN_HEAVY,'SlashPuff',(0.4,7),'214H2');
	}
	EBQB GGG 3;
	EBQB KK 2;
	Goto IDLE;
	
	214M:
	EBQB BCDE 3;
	EBQB J 14 {
		HitLine(96,(0,-19),HITSTUN_HEAVY,'SlashPuff',(0.4,6),'214M', MOVE_BLOCKLOW);
	}
	EBQB GG 3;
	EB5H H 3 {
		HitLine(96,(0,-16),HITSTUN_HEAVY,'SlashPuff',(-4,7),'214M2');
	}
	Goto IDLE;
	}
}